# 端口号
# PORT=3000
# 监听地址；桌面版应使用 127.0.0.1，容器内通常使用 0.0.0.0
# BIND_ADDRESS=0.0.0.0
# 前端基础URL
# FRONTEND_BASE_URL=https://your-frontend-url.com
# 浏览器跨域调用来源白名单，多个来源用英文逗号分隔；未配置时仅开放非凭据型通配 CORS
# CORS_ALLOW_ORIGINS=https://your-dashboard.example
# Session Cookie 是否强制 Secure；留空时 FRONTEND_BASE_URL 为 https:// 会自动开启
# SESSION_COOKIE_SECURE=true
# 可信代理列表，多个 IP/CIDR 用英文逗号分隔；未配置时禁用对 X-Forwarded-* 的信任
# TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8


# 调试相关配置
# 启用pprof
# ENABLE_PPROF=true
# pprof 监听地址，默认仅绑定本机回环地址
# PPROF_ADDR=127.0.0.1:8005
# 启用调试模式
# DEBUG=true
# Pyroscope 配置
# PYROSCOPE_URL=http://localhost:4040
# PYROSCOPE_APP_NAME=new-api
# PYROSCOPE_BASIC_AUTH_USER=your-user
# PYROSCOPE_BASIC_AUTH_PASSWORD=your-password
# PYROSCOPE_MUTEX_RATE=5
# PYROSCOPE_BLOCK_RATE=5
# HOSTNAME=your-hostname

# 数据库相关配置
# 启用错误日志记录
# ERROR_LOG_ENABLED=true
# 数据库连接字符串
# SQL_DSN=user:password@tcp(127.0.0.1:3306)/dbname?parseTime=true
# 日志数据库连接字符串
# LOG_SQL_DSN=user:password@tcp(127.0.0.1:3306)/logdb?parseTime=true
# ClickHouse 日志保留天数；大于 0 时 ClickHouse TTL 与主库 IP 安全投影使用同一保留窗口
# LOG_SQL_CLICKHOUSE_TTL_DAYS=30
# IP 安全投影重试间隔与单事务页大小
# IP_SECURITY_PROJECTION_RETRY_SECONDS=60
# IP_SECURITY_PROJECTION_BATCH_SIZE=500
# 留空时 master 默认运行、slave 默认关闭；也可显式设为 true 或 false
# IP_SECURITY_PROJECTION_WORKER_ENABLED=
# ClickHouse 使用业务时间游标；该重叠回扫窗口必须覆盖最大日志写入延迟和节点时钟偏差
# IP_SECURITY_CLICKHOUSE_OVERLAP_SECONDS=300
# 更换或重建同类型 LOG_SQL_DSN 时必须修改这个非敏感代际值，以触发安全的幂等全量重扫
# IP_SECURITY_LOG_SOURCE_GENERATION=logs-v1
# 已投递审计 outbox 的保留天数；默认 30，设为 0 可关闭清理，最大 3650
# AUDIT_OUTBOX_RETENTION_DAYS=30
# SQLite数据库路径
# SQLITE_PATH=/path/to/sqlite.db
# 数据库最大空闲连接数
# SQL_MAX_IDLE_CONNS=100
# 数据库最大打开连接数
# SQL_MAX_OPEN_CONNS=1000
# 数据库连接最大生命周期（秒）
# SQL_MAX_LIFETIME=60


# 缓存相关配置
# Redis连接字符串
# REDIS_CONN_STRING=redis://user:password@localhost:6379/0
# Redis 连接池大小
# REDIS_POOL_SIZE=20
# 同步频率（单位：秒）
# SYNC_FREQUENCY=60
# 内存缓存启用
# MEMORY_CACHE_ENABLED=true
# 渠道更新频率（单位：秒）
# CHANNEL_UPDATE_FREQUENCY=30
# 批量更新启用
# BATCH_UPDATE_ENABLED=true
# 批量更新间隔（单位：秒）
# BATCH_UPDATE_INTERVAL=5

# 任务和功能配置
# 更新任务启用
# UPDATE_TASK=true

# 对话超时设置
# 所有请求超时时间，单位秒，默认为0，表示不限制
# RELAY_TIMEOUT=0
# Relay HTTP 客户端空闲连接超时时间，单位秒，默认跟随 Go 标准库，设置为0表示不限制
# RELAY_IDLE_CONN_TIMEOUT=90
# 等待上游响应头的最长时间，单位秒，默认300；设为0仅关闭响应头等待限制，不影响流式正文
# RELAY_RESPONSE_HEADER_TIMEOUT=300
# Relay HTTP 客户端最大空闲连接数及单主机最大空闲连接数
# RELAY_MAX_IDLE_CONNS=500
# RELAY_MAX_IDLE_CONNS_PER_HOST=100
# 流模式无响应超时时间，单位秒，如果出现空补全可以尝试改为更大值
# STREAMING_TIMEOUT=300
# 收到终止信号后的优雅停机等待时间（秒）
# SHUTDOWN_TIMEOUT_SECONDS=120

# TLS / HTTP 跳过验证设置
# TLS_INSECURE_SKIP_VERIFY=false

# /api 请求体最大大小（KB），用于登录后管理接口和支付回调的统一保护；0 表示禁用
# API_REQUEST_BODY_LIMIT_KB=8192
# 匿名接口请求体上限（KB）、Relay 请求体上限（MB）与上游响应上限（MB）
# ANONYMOUS_REQUEST_BODY_LIMIT_KB=512
# MAX_REQUEST_BODY_MB=128
# UPSTREAM_RESPONSE_BODY_LIMIT_MB=128
# 远程文件下载及流式 Scanner 缓冲上限（MB）
# MAX_FILE_DOWNLOAD_MB=64
# STREAM_SCANNER_MAX_BUFFER_MB=128

# Gemini 识别图片 最大图片数量
# GEMINI_VISION_MAX_IMAGE_NUM=16

# 会话密钥
# SESSION_SECRET=random_string
# 独立数据加密密钥；生产环境建议与 SESSION_SECRET 分开生成并保持稳定
# CRYPTO_SECRET=another_random_string_at_least_32_bytes
# 生产部署模式会强制 SESSION_SECRET（及单独配置的 CRYPTO_SECRET）至少为 32 字节
# DEPLOYMENT_MODE=production
# Token Key 安全迁移阶段：schema -> dual-write -> dual-read -> cipher-only
# 非 schema 阶段必须同时配置下面两个稳定密钥；每个值均为 32 随机字节的 Base64。
# TOKEN_SECRET_PHASE=dual-write
# TOKEN_HMAC_KEY=replace_with_base64_32_random_bytes
# 加密密钥列表第一项写新密文，后续项仅用于解密旧版本；轮换时先添加新版本，不能删除仍在使用的旧版本。
# TOKEN_ENCRYPTION_KEYS=1:replace_with_base64_32_random_bytes
# TOKEN_SECRET_BACKFILL_BATCH_SIZE=100
# TOKEN_SECRET_BACKFILL_INTERVAL_SECONDS=300
# TOKEN_REVEAL_RATE_LIMIT=10
# TOKEN_REVEAL_RATE_LIMIT_SECONDS=60
# 启用 Secure session cookie，建议同时配置可信 HTTPS 入口地址；留空时可由 HTTPS FRONTEND_BASE_URL 自动启用
# SESSION_COOKIE_SECURE=false
# SESSION_COOKIE_TRUSTED_URL=https://example.com,https://admin.example.com

# 审计 outbox 投递间隔、批大小和已投递记录保留天数
# AUDIT_OUTBOX_INTERVAL_SECONDS=2
# AUDIT_OUTBOX_BATCH_SIZE=100
# AUDIT_OUTBOX_RETENTION_DAYS=30

# 其他配置
# 生成默认token
# GENERATE_DEFAULT_TOKEN=false
# Cohere 安全设置
# COHERE_SAFETY_SETTING=NONE
# 是否统计图片token
# GET_MEDIA_TOKEN=true
# 是否在非流（stream=false）情况下统计图片token
# GET_MEDIA_TOKEN_NOT_STREAM=false
# 设置 Dify 渠道是否输出工作流和节点信息到客户端
# DIFY_DEBUG=true

# LinuxDo相关配置
LINUX_DO_TOKEN_ENDPOINT=https://connect.linux.do/oauth2/token
LINUX_DO_USER_ENDPOINT=https://connect.linux.do/api/user

# 节点类型
# 如果是主节点则为master
# NODE_TYPE=master

# 可信任重定向域名列表（逗号分隔，支持子域名匹配）
# 用于验证支付成功/取消回调URL的域名安全性
# 示例: example.com,myapp.io 将允许 example.com, sub.example.com, myapp.io 等
# TRUSTED_REDIRECT_DOMAINS=example.com,myapp.io
