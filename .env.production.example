# Use URL-safe random values. Never commit the populated .env.production file.
POSTGRES_PASSWORD=replace_with_url_safe_random_password
REDIS_PASSWORD=replace_with_url_safe_random_password
SESSION_SECRET=replace_with_at_least_32_random_bytes
CRYPTO_SECRET=replace_with_a_distinct_32_byte_random_value
DEPLOYMENT_MODE=production

# Generate each key from 32 cryptographically random bytes and Base64-encode it.
# Keep these values stable across restarts and every application node.
TOKEN_SECRET_PHASE=dual-write
TOKEN_HMAC_KEY=replace_with_base64_32_random_bytes
TOKEN_ENCRYPTION_KEYS=1:replace_with_base64_32_random_bytes

# Public HTTPS URL and browser origins allowed to use credentialed CORS.
FRONTEND_BASE_URL=https://api.example.com
SESSION_COOKIE_TRUSTED_URL=https://api.example.com
CORS_ALLOW_ORIGINS=https://api.example.com

# IP or CIDR of the reverse proxy that is allowed to set X-Forwarded-*.
# For the bundled same-host Docker deployment, 172.18.0.1 is the host bridge
# address seen by the application. Replace it when the Docker network gateway
# differs; keep this limited to the actual reverse-proxy source address.
TRUSTED_PROXIES=172.18.0.1

# The app binds to loopback by default for a same-host TLS reverse proxy.
BIND_ADDRESS=127.0.0.1
PORT=3000
NODE_NAME=clove-api-1
TZ=Asia/Shanghai
CLOVE_API_IMAGE_TAG=v1.0.5-beta

# Keep the application pool below PostgreSQL's max_connections so health,
# migrations, backups, and operator sessions retain headroom.
SQL_MAX_IDLE_CONNS=40
SQL_MAX_OPEN_CONNS=120
SQL_MAX_LIFETIME=300
REDIS_POOL_SIZE=20

# Runtime and bounded I/O defaults. Increase only after measuring memory and
# upstream behavior; all values are per process.
SHUTDOWN_TIMEOUT_SECONDS=120
MAX_REQUEST_BODY_MB=128
UPSTREAM_RESPONSE_BODY_LIMIT_MB=128
MAX_FILE_DOWNLOAD_MB=64
STREAM_SCANNER_MAX_BUFFER_MB=128
ANONYMOUS_REQUEST_BODY_LIMIT_KB=512
API_REQUEST_BODY_LIMIT_KB=8192
RELAY_TIMEOUT=0
RELAY_IDLE_CONN_TIMEOUT=90
RELAY_RESPONSE_HEADER_TIMEOUT=300
RELAY_MAX_IDLE_CONNS=500
RELAY_MAX_IDLE_CONNS_PER_HOST=100
STREAMING_TIMEOUT=300

# Durable audit delivery and IP security projection workers.
AUDIT_OUTBOX_INTERVAL_SECONDS=2
AUDIT_OUTBOX_BATCH_SIZE=100
AUDIT_OUTBOX_RETENTION_DAYS=30
IP_SECURITY_PROJECTION_RETRY_SECONDS=60
IP_SECURITY_PROJECTION_BATCH_SIZE=500
# Empty follows NODE_TYPE (master enabled, slave disabled). Set true on a
# writable slave, or false to explicitly disable the worker on any node.
IP_SECURITY_PROJECTION_WORKER_ENABLED=
NODE_TYPE=master

# Optional separate ClickHouse log database. The overlap must cover maximum
# ingestion delay and clock skew. Change the generation whenever a LOG_SQL_DSN
# of the same database type is replaced or rebuilt so IP security data is rescanned.
# LOG_SQL_DSN=clickhouse://user:password@clickhouse:9000/default
# LOG_SQL_CLICKHOUSE_TTL_DAYS=30
# IP_SECURITY_CLICKHOUSE_OVERLAP_SECONDS=300
# IP_SECURITY_LOG_SOURCE_GENERATION=logs-v1
